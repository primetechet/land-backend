model RefreshToken {
  id                      String    @id @default(uuid())
  jti                     String    @unique
  family_id               String
  subject_user_id         String
  subject_type            String
  issued_at               DateTime  @default(now())
  expires_at              DateTime
  rotated_at              DateTime?
  revoked_at              DateTime?
  revoked_reason          String?
  last_ip                 String?
  last_user_agent         String?
  last_device_fingerprint String?
  created_at              DateTime  @default(now())
  updated_at              DateTime  @updatedAt

  @@index([family_id])
  @@index([subject_user_id, subject_type])
  @@index([expires_at])
  @@index([revoked_at])
  @@map("refresh_tokens")
}

