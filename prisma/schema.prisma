generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model TitleDeedApplication {
  id                                  String                               @id @default(uuid())
  old_id                              String?
  migrated_from_xoka_system           Boolean                              @default(false)
  is_organization                     Boolean                              @default(false)
  title_deed_number                   String?
  kebele                              String
  house_number                        String
  remark                              String?
  title_deed_service_id               String
  organization_type_id                String?
  woreda_id                           String
  branch_id                           String
  user_id                             String
  created_at                          DateTime                             @default(now())
  updated_at                          DateTime                             @updatedAt
  created_by_id                       String?
  updated_by_id                       String?
  archive_note                        String?
  archived                            Boolean                              @default(false)
  archived_at                         DateTime?
  archived_by_id                      String?
  authorized                          Boolean                              @default(false)
  authorized_at                       DateTime?
  authorized_by_id                    String?
  authorizer_note                     String?
  base_map_approved                   Boolean                              @default(false)
  base_map_approved_at                DateTime?
  base_map_approved_by_id             String?
  base_map_approver_note              String?
  plot_registered                     Boolean                              @default(false)
  plot_registered_at                  DateTime?
  plot_registered_by_id               String?
  plot_registration_note              String?
  rejected                            Boolean                              @default(false)
  rejected_at                         DateTime?
  rejected_by_id                      String?
  rejecter_note                       String?
  rejection_reason_id                 String?
  verified                            Boolean                              @default(false)
  verified_at                         DateTime?
  verified_by_id                      String?
  verifier_note                       String?
  submitted                           Boolean                              @default(false)
  submitted_at                        DateTime?
  application_no                      String                               @unique
  appointment_required                Boolean                              @default(false)
  appointment_required_at             DateTime?
  appointment_required_by_id          String?
  plots                               Plot[]
  titleDeedApplicationAppointments    TitleDeedApplicationAppointment[]
  titleDeedApplicationClientDocuments TitleDeedApplicationClientDocument[]
  titleDeedApplicationDocuments       TitleDeedApplicationDocument[]
  titleDeedApplicationOwners          TitleDeedApplicationOwner[]
  titleDeedApplicationPayments        TitleDeedApplicationPayment[]
  titleDeedApplicationReviews         TitleDeedApplicationReview[]
  appointmentRequiredBy               Employee?                            @relation("appointmentRequiredBy", fields: [appointment_required_by_id], references: [id])
  archivedBy                          Employee?                            @relation("archivedBy", fields: [archived_by_id], references: [id])
  authorizedBy                        Employee?                            @relation("authorizedBy", fields: [authorized_by_id], references: [id])
  baseMapApprovedBy                   Employee?                            @relation("baseMapApprovedBy", fields: [base_map_approved_by_id], references: [id])
  branch                              Branch                               @relation(fields: [branch_id], references: [id])
  organizationType                    OrganizationType?                    @relation(fields: [organization_type_id], references: [id])
  plotRegisteredBy                    Employee?                            @relation("plotRegisteredBy", fields: [plot_registered_by_id], references: [id])
  rejectedBy                          Employee?                            @relation("rejectedBy", fields: [rejected_by_id], references: [id])
  rejectionReason                     RejectionReason?                     @relation(fields: [rejection_reason_id], references: [id])
  titleDeedService                    TitleDeedService                     @relation(fields: [title_deed_service_id], references: [id])
  user                                User                                 @relation(fields: [user_id], references: [id])
  verifiedBy                          Employee?                            @relation("verifiedBy", fields: [verified_by_id], references: [id])
  woreda                              Woreda                               @relation(fields: [woreda_id], references: [id])

  @@map("title_deed_applications")
}

model TitleDeedApplicationClientDocument {
  id                                  String                       @id @default(uuid())
  title_deed_application_id           String
  attachment                          Json
  issued_at                           DateTime?
  expires_at                          DateTime?
  title_deed_service_document_type_id String
  rejected                            Boolean                      @default(false)
  rejected_at                         DateTime?
  rejected_by_id                      String?
  rejecter_note                       String?
  rejection_reason_id                 String?
  verified                            Boolean                      @default(false)
  verified_at                         DateTime?
  verified_by_id                      String?
  verifier_note                       String?
  created_by_id                       String?
  updated_by_id                       String?
  created_at                          DateTime                     @default(now())
  updated_at                          DateTime                     @updatedAt
  createdBy                           User?                        @relation(fields: [created_by_id], references: [id])
  rejectedBy                          Employee?                    @relation("rejectedBy", fields: [rejected_by_id], references: [id])
  rejectionReason                     RejectionReason?             @relation(fields: [rejection_reason_id], references: [id])
  titleDeedApplication                TitleDeedApplication         @relation(fields: [title_deed_application_id], references: [id])
  titleDeedServiceDocumentType        TitleDeedServiceDocumentType @relation(fields: [title_deed_service_document_type_id], references: [id])
  verifiedBy                          Employee?                    @relation("verifiedBy", fields: [verified_by_id], references: [id])

  @@map("title_deed_application_client_documents")
}

model TitleDeedApplicationDocument {
  id                        String               @id @default(uuid())
  title_deed_application_id String
  attachment                Json
  issued_at                 DateTime?
  expires_at                DateTime?
  created_by_id             String?
  updated_by_id             String?
  created_at                DateTime             @default(now())
  updated_at                DateTime             @updatedAt
  createdBy                 Employee?            @relation(fields: [created_by_id], references: [id])
  titleDeedApplication      TitleDeedApplication @relation(fields: [title_deed_application_id], references: [id])

  @@map("title_deed_application_documents")
}

model TitleDeedApplicationReview {
  id                        String               @id @default(uuid())
  reassigned                Boolean              @default(false)
  assignment_note           String?
  employee_id               String
  title_deed_application_id String
  reapplied                 Boolean              @default(false)
  completed                 Boolean              @default(false)
  completed_at              DateTime?
  completed_by_id           String?
  note                      String?
  role                      String
  created_at                DateTime             @default(now())
  updated_at                DateTime             @updatedAt
  created_by_id             String?
  updated_by_id             String?
  employee                  Employee             @relation(fields: [employee_id], references: [id])
  titleDeedApplication      TitleDeedApplication @relation(fields: [title_deed_application_id], references: [id])

  @@map("title_deed_application_reviews")
}

model TitleDeedApplicationOwner {
  id                          String               @id @default(uuid())
  migrated_from_xoka_system   Boolean              @default(false)
  photo                       Json                 @default("{}")
  signature                   Json                 @default("{}")
  is_organization             Boolean              @default(false)
  id_type                     IdType
  id_number                   String
  is_applicant                Boolean              @default(false)
  first_name                  String
  father_name                 String
  grand_father_name           String
  first_name_am               String
  father_name_am              String
  grand_father_name_am        String
  mother_first_name           String
  mother_father_name          String
  mother_grand_father_name    String
  mother_first_name_am        String
  mother_father_name_am       String
  mother_grand_father_name_am String
  gender                      Gender
  house_number                String
  title_deed_application_id   String
  disability_status_id        String
  nationality_id              String
  residency_country_id        String
  woreda_id                   String
  remark                      String?
  draft                       Boolean              @default(false)
  drafted_at                  DateTime?
  drafted_by_id               String?
  verified                    Boolean              @default(false)
  verified_at                 DateTime?
  verified_by_id              String?
  verifier_note               String?
  rejected                    Boolean              @default(false)
  rejected_at                 DateTime?
  rejected_by_id              String?
  rejecter_note               String?
  rejection_reason_id         String?
  created_at                  DateTime             @default(now())
  updated_at                  DateTime             @updatedAt
  created_by_id               String?
  updated_by_id               String?
  is_representative           Boolean              @default(false)
  disabilityStatus            DisabilityStatus     @relation(fields: [disability_status_id], references: [id])
  nationality                 Country              @relation("nationality", fields: [nationality_id], references: [id])
  residencyCountry            Country              @relation("residencyCountry", fields: [residency_country_id], references: [id])
  titleDeedApplication        TitleDeedApplication @relation(fields: [title_deed_application_id], references: [id])
  woreda                      Woreda               @relation(fields: [woreda_id], references: [id])
  verifiedBy                  Employee?            @relation("verifiedBy", fields: [verified_by_id], references: [id])
  rejectedBy                  Employee?            @relation("rejectedBy", fields: [rejected_by_id], references: [id])
  rejectionReason             RejectionReason?     @relation(fields: [rejection_reason_id], references: [id])

  @@unique([id_number, title_deed_application_id])
  @@map("title_deed_application_owners")
}

model TitleDeedApplicationPayment {
  id                        String                            @id @default(uuid())
  amount                    Float
  payment_reason            TitleDeedApplicationPaymentReason
  title_deed_application_id String
  remark                    String?
  paid                      Boolean                           @default(false)
  paid_at                   DateTime?
  paid_by_id                String?
  created_at                DateTime                          @default(now())
  updated_at                DateTime                          @updatedAt
  created_by_id             String?
  updated_by_id             String?
  titleDeedApplication      TitleDeedApplication              @relation(fields: [title_deed_application_id], references: [id])

  @@map("title_deed_application_payments")
}

model TitleDeedApplicationAppointment {
  id                        String               @id @default(uuid())
  date_time                 DateTime
  title_deed_application_id String
  remark                    String?
  created_at                DateTime             @default(now())
  updated_at                DateTime             @updatedAt
  created_by_id             String?
  updated_by_id             String?
  titleDeedApplication      TitleDeedApplication @relation(fields: [title_deed_application_id], references: [id])

  @@map("title_deed_application_appointments")
}

model Plot {
  id                        String               @id @default(uuid())
  geo                       Json
  plot_id                   String
  base_map_id               String?              @unique
  block_number              String?
  house_number              String?
  area_meter_square         Float
  parcel_number             String?
  certificate_number        String?
  remark                    String?
  title_deed_application_id String
  land_use_id               String
  land_grade_id             String
  holding_type_id           String
  tenure_type_id            String
  woreda_id                 String
  branch_id                 String
  built_up_area             Float?
  proportional_area         Float?
  floor_number              Float?
  global_id                 String
  arch_gis_created_user     String?
  base_map_approved         Boolean              @default(false)
  base_map_approved_at      DateTime?
  base_map_approved_by_id   String?
  base_map_approver_note    String?
  plot_registered_at        DateTime             @default(now())
  plot_registered_by_id     String
  plot_registration_note    String?
  authorized                Boolean              @default(false)
  authorized_at             DateTime?
  authorized_by_id          String?
  authorizer_note           String?
  rejected                  Boolean              @default(false)
  rejected_at               DateTime?
  rejected_by_id            String?
  rejecter_note             String?
  rejection_reason_id       String?
  owners_audit              Json? // Store complete owner information for auditing
  client_confirmed          Boolean              @default(false)
  client_confirmed_at       DateTime?
  client_confirmation_note  String?
  client_rejected           Boolean              @default(false)
  client_rejected_at        DateTime?
  client_rejection_note     String?
  created_at                DateTime             @default(now())
  updated_at                DateTime             @updatedAt
  created_by_id             String?
  updated_by_id             String?
  submitted                 Boolean              @default(false)
  submitted_at              DateTime?
  plotProperties            PlotProperty[]
  authorizedBy              Employee?            @relation("authorizedBy", fields: [authorized_by_id], references: [id])
  baseMapApprovedBy         Employee?            @relation("baseMapApprovedBy", fields: [base_map_approved_by_id], references: [id])
  branch                    Branch               @relation(fields: [branch_id], references: [id])
  landGrade                 LandGrade            @relation(fields: [land_grade_id], references: [id])
  landUse                   LandUse              @relation(fields: [land_use_id], references: [id])
  holdingType               HoldingType          @relation(fields: [holding_type_id], references: [id])
  tenureType                TenureType           @relation(fields: [tenure_type_id], references: [id])
  plotRegisteredBy          Employee             @relation("plotRegisteredBy", fields: [plot_registered_by_id], references: [id])
  rejectedBy                Employee?            @relation("rejectedBy", fields: [rejected_by_id], references: [id])
  rejectionReason           RejectionReason?     @relation(fields: [rejection_reason_id], references: [id])
  titleDeedApplication      TitleDeedApplication @relation(fields: [title_deed_application_id], references: [id])
  woreda                    Woreda               @relation(fields: [woreda_id], references: [id])

  @@map("plots")
}

model PlotProperty {
  id                         String           @id @default(uuid())
  property_id                String           @unique
  basement_floor_number      String
  upper_floor_number         String
  building_number            String
  house_number               String
  floor_number               String
  estimated_price            Float
  area_meter_square          Float
  parking_area_meter_square  Float
  building_size_meter_square Float
  number_of_lift             Int
  remark                     String?
  plot_id                    String
  property_use_id            String
  property_type_id           String
  base_map_approved          Boolean          @default(false)
  base_map_approved_at       DateTime?
  base_map_approved_by_id    String?
  base_map_approver_note     String?
  plot_registered_at         DateTime         @default(now())
  plot_registered_by_id      String
  plot_registration_note     String?
  rejected                   Boolean          @default(false)
  rejected_at                DateTime?
  rejected_by_id             String?
  rejecter_note              String?
  rejection_reason_id        String?
  created_at                 DateTime         @default(now())
  updated_at                 DateTime         @updatedAt
  created_by_id              String?
  updated_by_id              String?
  baseMapApprovedBy          Employee?        @relation("baseMapApprovedBy", fields: [base_map_approved_by_id], references: [id])
  plot                       Plot             @relation(fields: [plot_id], references: [id])
  plotRegisteredBy           Employee         @relation("plotRegisteredBy", fields: [plot_registered_by_id], references: [id])
  propertyType               PropertyType     @relation(fields: [property_type_id], references: [id])
  propertyUse                PropertyUse      @relation(fields: [property_use_id], references: [id])
  rejectedBy                 Employee?        @relation("rejectedBy", fields: [rejected_by_id], references: [id])
  rejectionReason            RejectionReason? @relation(fields: [rejection_reason_id], references: [id])

  @@map("plot_properties")
}

model User {
  id                                  String                               @id @default(uuid())
  user_type                           UserType
  id_type                             IdType
  name                                String
  username                            String                               @unique
  password                            String
  phone_number                        String                               @unique
  email                               String?                              @unique
  code_hash                           String?
  profile_image                       String?
  code_expiration                     DateTime?
  require_password_change             Boolean                              @default(false)
  username_verified                   Boolean                              @default(false)
  username_verified_at                DateTime?
  is_active                           Boolean                              @default(true)
  active_status_updated_at            DateTime?
  active_status_updated_by_id         String?
  status_update_note                  String?
  is_suspended                        Boolean                              @default(false)
  suspended_status_updated_at         DateTime?
  suspended_status_updated_by_id      String?
  suspended_status_update_note        String?
  secondary_id_type                   IdType?
  secondary_id                        String?
  primary_id_verified                 Boolean                              @default(false)
  secondary_id_verified               Boolean                              @default(false)
  created_at                          DateTime                             @default(now())
  updated_at                          DateTime                             @updatedAt
  created_by_id                       String?
  updated_by_id                       String?
  loginHistories                      LoginHistory[]
  otps                                Otp[]
  titleDeedApplicationClientDocuments TitleDeedApplicationClientDocument[]
  titleDeedApplications               TitleDeedApplication[]
  userRoles                           UserRole[]

  @@map("users")
}

model Employee {
  id                                         String                               @id @default(uuid())
  name                                       String
  username                                   String                               @unique
  password                                   String
  phone_number                               String                               @unique
  email                                      String?                              @unique
  code_hash                                  String?
  profile_image                              String?
  code_expiration                            DateTime?
  require_password_change                    Boolean                              @default(false)
  username_verified                          Boolean                              @default(false)
  username_verified_at                       DateTime?
  is_active                                  Boolean                              @default(true)
  active_status_updated_at                   DateTime?
  active_status_updated_by_id                String?
  status_update_note                         String?
  is_suspended                               Boolean                              @default(false)
  suspended_status_updated_at                DateTime?
  suspended_status_updated_by_id             String?
  suspended_status_update_note               String?
  branch_id                                  String?
  branch                                     Branch?                              @relation(fields: [branch_id], references: [id])
  created_at                                 DateTime                             @default(now())
  updated_at                                 DateTime                             @updatedAt
  created_by_id                              String?
  updated_by_id                              String?
  employeeLoginHistories                     EmployeeLoginHistory[]
  employeeRoles                              EmployeeRole[]
  baseMapApprovedPlotProperty                PlotProperty[]                       @relation("baseMapApprovedBy")
  plotRegisteredPlotProperty                 PlotProperty[]                       @relation("plotRegisteredBy")
  rejectedPlotProperty                       PlotProperty[]                       @relation("rejectedBy")
  authorizedPlot                             Plot[]                               @relation("authorizedBy")
  baseMapApprovedPlot                        Plot[]                               @relation("baseMapApprovedBy")
  plotRegisteredPlot                         Plot[]                               @relation("plotRegisteredBy")
  rejectedPlot                               Plot[]                               @relation("rejectedBy")
  rejectedTitleDeedApplicationClientDocument TitleDeedApplicationClientDocument[] @relation("rejectedBy")
  verifiedTitleDeedApplicationClientDocument TitleDeedApplicationClientDocument[] @relation("verifiedBy")
  titleDeedApplicationDocuments              TitleDeedApplicationDocument[]
  titleDeedApplicationReviews                TitleDeedApplicationReview[]
  appointmentRequiredTitleDeedApplication    TitleDeedApplication[]               @relation("appointmentRequiredBy")
  archivedTitleDeedApplication               TitleDeedApplication[]               @relation("archivedBy")
  authorizedTitleDeedApplication             TitleDeedApplication[]               @relation("authorizedBy")
  baseMapApprovedTitleDeedApplication        TitleDeedApplication[]               @relation("baseMapApprovedBy")
  plotRegisteredTitleDeedApplication         TitleDeedApplication[]               @relation("plotRegisteredBy")
  rejectedTitleDeedApplication               TitleDeedApplication[]               @relation("rejectedBy")
  verifiedTitleDeedApplication               TitleDeedApplication[]               @relation("verifiedBy")
  verifiedTitleDeedApplicationOwners         TitleDeedApplicationOwner[]          @relation("verifiedBy")
  rejectedTitleDeedApplicationOwners         TitleDeedApplicationOwner[]          @relation("rejectedBy")

  @@map("employees")
}

model Otp {
  id         String   @id @default(uuid())
  user_id    String
  otp        String
  created_at DateTime @default(now())
  expires_at DateTime
  user       User     @relation(fields: [user_id], references: [id])

  @@map("otp")
}

model LoginHistory {
  id         String   @id @default(uuid())
  user_id    String
  ip_address String
  lat        String?
  lng        String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  user       User     @relation(fields: [user_id], references: [id])

  @@map("login_histories")
}

model EmployeeLoginHistory {
  id            String   @id @default(uuid())
  is_successful Boolean  @default(true)
  employee_id   String
  ip_address    String
  lat           String?
  lng           String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  employee      Employee @relation(fields: [employee_id], references: [id])

  @@map("employee_login_histories")
}

model PermissionAction {
  id                            String                         @id @default(uuid())
  action                        String                         @unique
  description                   String?
  draft                         Boolean                        @default(false)
  created_at                    DateTime                       @default(now())
  updated_at                    DateTime                       @updatedAt
  rolePermissionResourceActions RolePermissionResourceAction[]

  @@map("permission_actions")
}

model PermissionResource {
  id                      String                   @id @default(uuid())
  name                    String                   @unique
  description             String?
  draft                   Boolean                  @default(false)
  created_at              DateTime                 @default(now())
  updated_at              DateTime                 @updatedAt
  rolePermissionResources RolePermissionResource[]

  @@map("permission_resources")
}

model Role {
  id                      String                   @id @default(uuid())
  name                    String                   @unique
  description             String?
  switchable              Boolean                  @default(false)
  editable                Boolean                  @default(false)
  draft                   Boolean                  @default(false)
  created_at              DateTime                 @default(now())
  updated_at              DateTime                 @updatedAt
  employeeRoles           EmployeeRole[]
  rolePermissionResources RolePermissionResource[]
  userRoles               UserRole[]

  @@map("roles")
}

model RolePermissionResource {
  id                            String                         @id @default(uuid())
  role_id                       String
  permission_resource_id        String
  created_at                    DateTime                       @default(now())
  updated_at                    DateTime                       @updatedAt
  rolePermissionResourceActions RolePermissionResourceAction[]
  permissionResource            PermissionResource             @relation(fields: [permission_resource_id], references: [id])
  role                          Role                           @relation(fields: [role_id], references: [id])

  @@unique([permission_resource_id, role_id])
  @@map("role_permission_resources")
}

model RolePermissionResourceAction {
  id                          String                 @id @default(uuid())
  permission_action_id        String
  role_permission_resource_id String
  created_at                  DateTime               @default(now())
  updated_at                  DateTime               @updatedAt
  permissionAction            PermissionAction       @relation(fields: [permission_action_id], references: [id])
  rolePermissionResource      RolePermissionResource @relation(fields: [role_permission_resource_id], references: [id])

  @@unique([role_permission_resource_id, permission_action_id])
  @@map("role_permission_resource_actions")
}

model UserRole {
  id            String    @id @default(uuid())
  user_id       String
  role_id       String
  created_at    DateTime  @default(now())
  updated_at    DateTime? @updatedAt
  created_by_id String?
  updated_by_id String?
  role          Role      @relation(fields: [role_id], references: [id])
  user          User      @relation(fields: [user_id], references: [id])

  @@unique([role_id, user_id])
  @@map("user_roles")
}

model EmployeeRole {
  id            String    @id @default(uuid())
  employee_id   String
  role_id       String
  created_at    DateTime  @default(now())
  updated_at    DateTime? @updatedAt
  created_by_id String?
  updated_by_id String?
  employee      Employee  @relation(fields: [employee_id], references: [id])
  role          Role      @relation(fields: [role_id], references: [id])

  @@unique([role_id, employee_id])
  @@map("employee_roles")
}

model TitleDeedService {
  id                            String                         @id @default(uuid())
  name                          String                         @unique
  name_json                     Json                           @default("{}")
  icon                          Json?
  description                   String?
  description_json              Json?                          @default("{}")
  has_existing_title_deed       Boolean                        @default(false)
  parent_title_deed_service_id  String?
  draft                         Boolean                        @default(false)
  drafted_at                    DateTime?
  drafted_by_id                 String?
  created_at                    DateTime                       @default(now())
  updated_at                    DateTime                       @updatedAt
  created_by_id                 String?
  updated_by_id                 String?
  applicant_type                APPLICANT_TYPE                 @default(BOTH)
  titleDeedServiceDocumentTypes TitleDeedServiceDocumentType[]
  titleDeedApplications         TitleDeedApplication[]
  titleDeedServiceBranches      TitleDeedServiceBranch[]
  titleDeedServicePayments      TitleDeedServicePayment[]
  titleDeedServiceRequirements  TitleDeedServiceRequirement[]
  titleDeedService              TitleDeedService?              @relation("TitleDeedServiceToTitleDeedService", fields: [parent_title_deed_service_id], references: [id])
  childrenTitleDeedServices     TitleDeedService[]             @relation("TitleDeedServiceToTitleDeedService")

  @@map("title_deed_services")
}

model TitleDeedServicePayment {
  id                    String                            @id @default(uuid())
  amount                Float
  payment_reason        TitleDeedApplicationPaymentReason
  title_deed_service_id String
  remark                String?
  draft                 Boolean                           @default(false)
  drafted_at            DateTime?
  drafted_by_id         String?
  created_at            DateTime                          @default(now())
  updated_at            DateTime                          @updatedAt
  created_by_id         String?
  updated_by_id         String?
  titleDeedService      TitleDeedService                  @relation(fields: [title_deed_service_id], references: [id])

  @@map("title_deed_service_payments")
}

model TitleDeedServiceRequirement {
  id                    String           @id @default(uuid())
  description           String
  description_json      Json?            @default("{}")
  draft                 Boolean          @default(false)
  drafted_at            DateTime?
  drafted_by_id         String?
  created_at            DateTime         @default(now())
  updated_at            DateTime         @updatedAt
  created_by_id         String?
  updated_by_id         String?
  title_deed_service_id String
  titleDeedService      TitleDeedService @relation(fields: [title_deed_service_id], references: [id])

  @@unique([title_deed_service_id, description])
  @@map("title_deed_service_requirements")
}

model TitleDeedServiceBranch {
  id                    String           @id @default(uuid())
  description           String?
  description_json      Json?            @default("{}")
  branch_id             String
  title_deed_service_id String
  draft                 Boolean          @default(false)
  drafted_at            DateTime?
  drafted_by_id         String?
  created_at            DateTime         @default(now())
  updated_at            DateTime         @updatedAt
  created_by_id         String?
